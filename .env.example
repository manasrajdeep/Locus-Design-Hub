# Copy to .env and fill in. .env is gitignored — never commit real values.
# On Cloudflare these are set as Worker secrets/vars, not from this file.

# --- Supabase (public; safe to ship to the browser) -------------------------
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Supabase (server-only; bypasses row-level security) --------------------
# Required by scripts/rls-audit.ts and any server handler importing
# `supabaseAdmin` from src/integrations/supabase/client.server.ts.
# Must never be exposed with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public origin ----------------------------------------------------------
# Single source of truth for the canonical tag, Open Graph URLs, JSON-LD,
# /sitemap.xml, /robots.txt and the search-engine submissions. Scheme, no
# trailing slash. See src/lib/site.ts.
SITE_URL=https://locusdesign.online
VITE_SITE_URL=https://locusdesign.online

# --- Error tracking ---------------------------------------------------------
# Leave blank to disable — all reporting is inert without a DSN.
# VITE_SENTRY_DSN is the browser SDK, SENTRY_DSN the Cloudflare Worker SDK.
VITE_SENTRY_DSN=
SENTRY_DSN=

# --- Tenant-isolation audit (/diagnostics) ----------------------------------
# A SEPARATE, disposable Supabase project with the same migrations applied.
# The audit seeds and deletes real users, projects and storage objects with a
# service-role key, and refuses to run if these resolve to the project above.
RLS_AUDIT_SUPABASE_URL=
RLS_AUDIT_SUPABASE_PUBLISHABLE_KEY=
RLS_AUDIT_SUPABASE_SERVICE_ROLE_KEY=

# --- Playwright destructive specs -------------------------------------------
# Same disposable project. Without these the destructive specs skip and the
# rest of the suite still runs.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
